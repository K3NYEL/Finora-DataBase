# Bind to loopback by default; configure a trusted HTTPS reverse proxy before public exposure.
HOST=127.0.0.1
PORT=3000
# SQLite file path; keep database files out of Git.
DATABASE_PATH=./data/finora.db
# Encrypted backup files; keep this directory outside the web root and persistent across deployments.
BACKUP_STORAGE_PATH=./data/backups
# Comma-separated exact origins; leave empty until the actual web origin is known.
CORS_ORIGINS=

# Required to publish notifications or patch manifests. Generate a unique random secret (32+ characters).
FINORA_ADMIN_KEY=
